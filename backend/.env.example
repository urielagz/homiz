# Copia este archivo como .env y llena los valores. No subas .env al repositorio.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://postgres:@localhost:5432/homiz


# JWT: genera ambos con `npm run secrets` (mínimo 32 caracteres, distintos entre sí)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# Seguridad de acceso
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_MINUTES=60
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=20

# Enlace de "olvidé mi contraseña" del PERSONAL: el panel (se le agrega ?token=...)
APP_RESET_URL="http://localhost:5500/admin/#/login"
# Enlace de los CLIENTES: la app Homiz (crear o recuperar contraseña: ?reset=...&email=...)
APP_CLIENT_URL=http://localhost:5600/

# Correo. "outbox" guarda cada correo como archivo en MAIL_OUTBOX_DIR (no se envía).
# "smtp" lo envía de verdad. Con Gmail: activa la verificación en dos pasos y crea una «contraseña de aplicación»
# en https://myaccount.google.com/apppasswords (16 letras); esa va en SMTP_PASS, no tu contraseña normal.
MAIL_DRIVER=outbox
MAIL_OUTBOX_DIR=outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inmobiliaria Zugar <tu-correo@gmail.com>"

# Pruebas automáticas (npm test): base DEDICADA, se borra y recarga en cada corrida
TEST_DATABASE_URL=postgres://homiz:cambia-esta-clave@localhost:5432/homiz_test

# CORS: orígenes permitidos separados por coma (sitio web y panel)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# URL pública de esta API (se usa para armar los enlaces firmados del almacenamiento local).
# Para abrir documentos y fotos desde el emulador de Android usa http://10.0.2.2:3000 (o la IP de tu PC).
API_PUBLIC_URL=http://localhost:3000

# Almacenamiento de archivos: "local" (carpeta uploads/) o "r2" (Cloudflare R2, compatible con S3)
# R2: Cloudflare → R2 → crea el bucket (privado) → «Manage R2 API Tokens» → token «Object Read & Write» para ese bucket.
# Luego: npm run r2:setup -- --migrar  (prueba la conexión, configura CORS y copia uploads/ al bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_URL_MINUTES=15
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Notificaciones push: "mock" en desarrollo o "fcm"
PUSH_DRIVER=mock
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Tareas programadas (vencimientos y recordatorios), hora de Cancún
JOBS_ENABLED=true
JOBS_CRON=0 7 * * *
TZ_APP=America/Cancun
# Sitio público: la app enlaza aquí el aviso de privacidad y «Eliminar mi cuenta»
SITE_URL=https://zugar.mx
