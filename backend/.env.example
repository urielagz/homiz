# Copia este archivo como .env y llena los valores. No subas .env al repositorio.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://homiz:cambia-esta-clave@localhost:5432/homiz

# JWT: genera ambos con `npm run secrets` (mínimo 32 caracteres, distintos entre sí)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# Seguridad de acceso
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_MINUTES=60
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=20

# Página a la que apunta el enlace de "olvidé mi contraseña" (se le agrega ?token=...)
APP_RESET_URL=http://localhost:5500/web/admin/login.html
# En desarrollo los correos se guardan como archivos en esta carpeta (no se envían)
MAIL_OUTBOX_DIR=outbox

# Pruebas automáticas (npm test): base DEDICADA, se borra y recarga en cada corrida
TEST_DATABASE_URL=postgres://homiz:cambia-esta-clave@localhost:5432/homiz_test

# CORS: orígenes permitidos separados por coma (sitio web y panel)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# URL pública de esta API (se usa para armar los enlaces firmados del almacenamiento local)
API_PUBLIC_URL=http://localhost:3000

# Almacenamiento de archivos: "local" (carpeta uploads/) o "r2" (Cloudflare R2, compatible con S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_URL_MINUTES=15
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Notificaciones push: "mock" en desarrollo o "fcm"
PUSH_DRIVER=mock
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Tareas programadas (vencimientos y recordatorios), hora de Cancún
JOBS_ENABLED=true
JOBS_CRON=0 7 * * *
TZ_APP=America/Cancun
